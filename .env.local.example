# Copy this file to .env.local and fill in your Firebase credentials

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public address of the site, used for metadata, canonical URLs, the sitemap,
# robots.txt and the social preview image. Set this in Vercel after pointing a
# custom domain at the project, then redeploy. Defaults to the vercel.app URL.
NEXT_PUBLIC_SITE_URL=https://fabjanelezi.me
